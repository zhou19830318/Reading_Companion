# Template for /etc/reading-companion/voice-relay.env (root:voice-relay 640).
# install.sh writes a filled-in development copy on first run.
# Never commit a real key. Switching to the real providers needs only this
# file plus: systemctl restart reading-companion-relay

RELAY_ENV=development
RELAY_BIND=127.0.0.1
RELAY_PORT=8000
RELAY_LOG_LEVEL=INFO
RELAY_VERSION=dev

# Device auth: shared token or per-device map "deviceId:token,...".
# The device stores only this token, never the cloud API key.
RELAY_DEVICE_TOKEN=change-me
#RELAY_DEVICE_TOKENS=
#ALLOWED_DEVICE_IDS=reading-companion-001
#RELAY_ADMIN_TOKEN=change-me   # POST /api/v1/chat (SSE debug) + remote /admin?token=
#RELAY_PUBLIC_URL=wss://voice.example.com/api/v1/voice/stream  # overrides the URL shown on /admin

# --- providers: mock (default) or real DashScope -------------------------
ASR_PROVIDER=mock
LLM_PROVIDER=mock

# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_REGION=cn-beijing
# ASR_PROVIDER=paraformer
# ASR_MODEL=paraformer-realtime-v2
# LLM_PROVIDER=dashscope-openai-compatible
# LLM_MODEL=qwen-flash
# LLM_DISABLE_THINKING=true

# --- dictionary cards (reader: long-press word -> 字典) -------------------
# local (default): the offline data shipped in dict-data/ next to this
# release. Nothing is generated, misses show "未收录". llm: model-generated
# cards (pre-local behavior, may contain factual errors).
DICT_SOURCE=local
# Override the data directory (default: <release>/dict-data):
#DICT_DATA_DIR=/opt/reading-companion-relay/current/dict-data

# --- text-to-image cards (POST /api/v1/image) ------------------------------
# mock (default): a placeholder is drawn locally with Pillow — the whole
# endpoint/asset path works with no image quota. dashscope: wanx task submit
# + poll, needs DASHSCOPE_API_KEY above. openai: one-shot POST to an
# OpenAI-compatible images endpoint (T2I_BASE_URL/T2I_API_KEY below).
T2I_PROVIDER=mock
T2I_MODEL=wanx2.1-t2i-turbo
T2I_SIZE=768*1280
#T2I_TIMEOUT_S=150
#T2I_POLL_INTERVAL_S=3
#T2I_MOCK_DELAY_S=2.5
# Onepage panel size; the server converts + dithers to a 1-bit BMP here.
#T2I_WIDTH=480
#T2I_HEIGHT=800
# OpenAI-compatible endpoints (T2I_PROVIDER=openai). T2I_BASE_URL is the
# prefix in front of /images/generations, e.g. https://api.openai.com/v1.
#T2I_BASE_URL=https://api.openai.com/v1
#T2I_API_KEY=sk-...
# Must be inside the systemd sandbox's writable paths (see the unit's
# ReadWritePaths): keep it under /opt/reading-companion-relay/run/.
T2I_ASSET_DIR=/opt/reading-companion-relay/run/t2i
# Assets older than this are dropped on the next save.
#T2I_ASSET_TTL_S=86400

# Vocabulary learning database directory (learning.db, SQLite). Same rule as
# T2I_ASSET_DIR: must sit under /opt/reading-companion-relay/run/ so it
# survives release swaps without a systemd unit change. Empty = run/learning
# relative to the working directory (development default).
RELAY_LEARNING_DIR=/opt/reading-companion-relay/run/learning

# Pomodoro focus-session database directory (pomodoro.db, SQLite). Same rule
# as RELAY_LEARNING_DIR. Empty = run/pomodoro (development default).
RELAY_POMODORO_DIR=/opt/reading-companion-relay/run/pomodoro

# --- Server-managed device registry (/admin/devices) ---------------------
# Devices added on /admin are stored in <RELAY_DEVICE_DIR>/devices.json (0600).
# Once the registry has entries it is authoritative for device tokens; each
# record can carry its own Relay URL. Keep this under run/ so it survives
# release swaps. Empty = run/devices (development default).
RELAY_DEVICE_DIR=/opt/reading-companion-relay/run/devices

# --- Read-only market snapshots (GET /api/v1/markets/*) -------------------
# Public quotes only: Tencent for CN/HK, Yahoo for US/futures, CNBC for the
# US index intraday line. If those are unreachable, US indexes fall back to
# Eastmoney/Tencent and commodities/US stocks to Sina.
# No API key. Quote cache is short (60 s); daily charts are cached 15 min.
# On upstream failure the last good snapshot is served up to MARKET_STALE_S.
#MARKET_TIMEOUT_S=10
#MARKET_QUOTE_TTL_S=60
#MARKET_CHART_TTL_S=900
#MARKET_STALE_S=86400

# Pigeon device-to-device messages (pigeon.db, SQLite). Same run/ rule as the
# other stores. Delivery retention is bounded; devices fetch history on entry.
RELAY_PIGEON_DIR=/opt/reading-companion-relay/run/pigeon
#PIGEON_MESSAGE_TTL_DAYS=7
#PIGEON_MAX_MESSAGES_PER_RECIPIENT=100
#PIGEON_MAX_TEXT_BYTES=512
#PIGEON_RATE_LIMIT_PER_MINUTE=30
#PIGEON_PRESENCE_TTL_SECONDS=45

# Limits (docs section 8). MAX_CONCURRENT_SESSIONS must stay within the
# DashScope account concurrency quota for the ASR model.
MAX_AUDIO_SECONDS=30
MAX_LLM_OUTPUT_TOKENS=256
MAX_REPLY_CHARS=500
SESSION_IDLE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SESSIONS=4

# Multiple onepage devices share this relay: sockets are capped so a
# reconnect loop cannot exhaust fds, and each device gets one voice session.
MAX_WS_CONNECTIONS=32
MAX_SESSIONS_PER_DEVICE=1
